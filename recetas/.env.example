# Copia este archivo a .env y rellena tu key: cp .env.example .env
# Consíguela en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Token de acceso a TU app.
# Si lo dejas vacío la API queda abierta (cómodo en tu red local).
# OBLIGATORIO si la despliegas en internet: sin él, cualquiera que encuentre la
# URL gasta tu saldo de API. Genera uno con:  openssl rand -hex 24
APP_TOKEN=

# Opcionales
PORT=3000
ANTHROPIC_MODEL=claude-opus-5
TZ_USUARIO=Europe/Madrid
